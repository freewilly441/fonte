from __future__ import annotations

import subprocess
import time
from typing import Callable

import requests

LMS_PORT = 1234
LMS_API_MODELS_URL = f"http://localhost:{LMS_PORT}/v1/models"
MODELS = [
    "google/gemma-3-1b",
    "qwen/qwen3-1.7b",
]


def _run(cmd: str) -> None:
    subprocess.run(
        cmd,
        shell=True,
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def _run_server_start() -> None:
    subprocess.Popen(
        f"lms server start --port {LMS_PORT}",
        shell=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def server_running() -> bool:
    try:
        response = requests.get(LMS_API_MODELS_URL, timeout=2)
        return response.status_code == 200
    except Exception:
        return False


def _wait_for_server(retries: int = 30, delay_seconds: float = 1.0) -> bool:
    for _ in range(retries):
        if server_running():
            return True
        time.sleep(delay_seconds)
    return False


def bootstrap_runtime(status_callback: Callable[[str], None] | None = None) -> None:
    if server_running():
        return

    if status_callback is not None:
        status_callback("Initializing AI runtime...")
    _run("lms daemon up")

    if status_callback is not None:
        status_callback("Loading models...")
    for model in MODELS:
        _run(f"lms load {model}")

    if status_callback is not None:
        status_callback("Starting inference engine...")
    _run_server_start()

    if not _wait_for_server():
        raise RuntimeError("LM Studio server failed to start")
